# ===================================================================
# MenuMind AI Backend - Environment Configuration Template
# Copy this file to .env and configure your MySQL database credentials.
# DO NOT commit your .env file containing live database passwords!
# ===================================================================

# MySQL / Aiven Cloud Database
DB_HOST=your-mysql-host.aivencloud.com
DB_PORT=25107
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your_database_password_here

# JWT Signing Secret (256-bit key)
JWT_SECRET=your_jwt_secret_key_here
